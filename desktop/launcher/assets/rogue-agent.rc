#include <winres.h>

1 ICON "rogue-agent.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "rogue-agent.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Rogue Agent"
      VALUE "FileDescription", "Rogue Agent decompiler"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "RogueAgent"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "RogueAgent.exe"
      VALUE "ProductName", "Rogue Agent"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
